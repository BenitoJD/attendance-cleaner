<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AttendanceCleaner.MainPage"
             Title="Attendance Cleaner">

    <Grid RowDefinitions="Auto,*">

        <!-- convert section (scrollable so portrait and landscape both fit) -->
        <ScrollView x:Name="ConvertSection" Grid.Row="0">
            <VerticalStackLayout
                VerticalOptions="Center"
                Padding="40"
                Spacing="20">

            <Label
                Text="Attendance Cleaner"
                FontSize="28"
                FontAttributes="Bold"
                HorizontalTextAlignment="Center" />

            <Label
                Text="Choose the report downloaded from the attendance software. The clean Excel is saved next to it."
                FontSize="15"
                TextColor="Gray"
                HorizontalTextAlignment="Center" />

            <Button
                x:Name="PickFileBtn"
                Text="Choose Excel file"
                Clicked="OnPickFileClicked"
                HorizontalOptions="Fill" />

            <Button
                x:Name="ConvertBtn"
                Text="Convert &amp; save"
                IsEnabled="False"
                Clicked="OnConvertClicked"
                HorizontalOptions="Fill" />

            <Label
                x:Name="FileNameLabel"
                Text=""
                FontSize="13"
                HorizontalTextAlignment="Center" />

            <Label
                x:Name="StatusLabel"
                Text=""
                FontSize="13"
                HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- results section: the converted rows, shown like the Excel sheet -->
        <Grid
            x:Name="ResultsSection"
            Grid.Row="1"
            IsVisible="False"
            RowDefinitions="Auto,Auto,Auto,*"
            Padding="16"
            RowSpacing="4">

            <Label x:Name="SummaryLabel" FontAttributes="Bold" FontSize="16" />

            <Label x:Name="SavedLabel" Grid.Row="1" FontSize="12" TextColor="#6B7280" />

            <Button
                Grid.Row="2"
                Text="Convert another file"
                FontSize="12"
                Padding="14,6"
                HorizontalOptions="Start"
                Clicked="OnConvertAnotherClicked" />

            <ScrollView Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                <Grid x:Name="TableGrid" RowDefinitions="Auto,*" RowSpacing="0">

                    <!-- virtualised list: only the visible rows are laid out, so rotation stays smooth.
                         Header row and row cells are generated from TemplateSpec in code-behind,
                         with column widths computed from the content. -->
                    <ListView x:Name="ItemsView" Grid.Row="1" RowHeight="32" CachingStrategy="RecycleElement" SeparatorVisibility="None" />
                </Grid>
            </ScrollView>
        </Grid>

        <ActivityIndicator
            x:Name="Spinner"
            IsRunning="False"
            IsVisible="False"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            Grid.RowSpan="2" />
    </Grid>

</ContentPage>
