<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:core="clr-namespace:AttendanceCleaner.Core;assembly=AttendanceCleaner.Core"
             xmlns:local="clr-namespace:AttendanceCleaner"
             x:Class="AttendanceCleaner.MainPage"
             BackgroundColor="{AppThemeBinding Light={StaticResource CanvasLight}, Dark={StaticResource CanvasDark}}"
             Title="Attendance Report Studio">

    <Grid>
        <!-- One vertical scroll owns the clock, report summary, tabs and report content. -->
        <ScrollView x:Name="PageScroll" VerticalScrollBarVisibility="Default">
            <Grid RowDefinitions="Auto,Auto">

        <Border Grid.Row="0" Margin="20,8,20,0"
                Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                StrokeThickness="0.5"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource SurfaceDark}}"
                StrokeShape="RoundRectangle 12" Padding="12,6">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8" HeightRequest="32">
                <Label Text="Indian Time" FontSize="10" FontAttributes="Bold" CharacterSpacing="0.5"
                       VerticalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                <Label x:Name="IstTimeLabel" Grid.Column="1" Text="--:--:-- AM" FontSize="18" FontAttributes="Bold"
                       VerticalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                       SemanticProperties.Hint="Tap or click to switch the clock format">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnIstTimeTapped" />
                    </Label.GestureRecognizers>
                </Label>
                <Label x:Name="IstDateLabel" Grid.Column="3" Text="" FontSize="10"
                       HorizontalTextAlignment="End" VerticalTextAlignment="Center" LineBreakMode="NoWrap"
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
            </Grid>
        </Border>

        <!-- ═══════════ choose report type and upload ═══════════ -->
        <ContentView x:Name="ConvertSection" Grid.Row="1">
            <VerticalStackLayout
                VerticalOptions="Center"
                HorizontalOptions="Center"
                Padding="24,26,24,32"
                Spacing="20"
                MaximumWidthRequest="600">

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" HorizontalOptions="Fill">
                    <Border StrokeThickness="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource ActionLight}, Dark={StaticResource ActionDark}}"
                            StrokeShape="RoundRectangle 16"
                            WidthRequest="50" HeightRequest="50" VerticalOptions="Center">
                        <Label Text="✓"
                               TextColor="{AppThemeBinding Light={StaticResource ActionTextLight}, Dark={StaticResource ActionTextDark}}"
                               FontSize="26" FontAttributes="Bold"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                        <Label Text="Attendance Report Studio" FontSize="23" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                        <Label Text="Turn raw attendance exports into clear daily and monthly Excel or PDF reports."
                               FontSize="13" LineBreakMode="WordWrap"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    </VerticalStackLayout>
                </Grid>

                <VerticalStackLayout Spacing="12">
                    <VerticalStackLayout Spacing="4" Margin="0,4,0,0">
                        <Label Text="CHOOSE A TEMPLATE" FontSize="12" FontAttributes="Bold" CharacterSpacing="1"
                               TextColor="{AppThemeBinding Light={StaticResource SuccessLight}, Dark={StaticResource SuccessDark}}" />
                        <Label Text="Select the report period to continue." FontSize="14"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    </VerticalStackLayout>

                    <Border x:Name="DailyTemplateCard"
                            Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" StrokeThickness="1"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                            StrokeShape="RoundRectangle 18" Padding="15">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border WidthRequest="44" HeightRequest="44" StrokeThickness="0"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurfaceLight}, Dark={StaticResource AccentSurfaceDark}}"
                                    StrokeShape="RoundRectangle 14" VerticalOptions="Center">
                                <Label Text="D" FontSize="19" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource AccentTextLight}, Dark={StaticResource AccentTextDark}}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                <Label Text="Daily" FontSize="16" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                <Label Text="Format a one-day attendance report" FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                            </VerticalStackLayout>
                            <Button x:Name="DailyTemplateButton" Grid.Column="2" Text="Select"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource ActionLight}, Dark={StaticResource ActionDark}}"
                                    TextColor="{AppThemeBinding Light={StaticResource ActionTextLight}, Dark={StaticResource ActionTextDark}}"
                                    FontSize="13" FontAttributes="Bold"
                                    CornerRadius="11" Padding="13,9" VerticalOptions="Center"
                                    Clicked="OnDailyTemplateClicked" />
                        </Grid>
                    </Border>

                    <Border x:Name="MonthlyTemplateCard"
                            Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" StrokeThickness="1"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                            StrokeShape="RoundRectangle 18" Padding="15">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border WidthRequest="44" HeightRequest="44" StrokeThickness="0"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurfaceLight}, Dark={StaticResource AccentSurfaceDark}}"
                                    StrokeShape="RoundRectangle 14" VerticalOptions="Center">
                                <Label Text="M" FontSize="19" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource AccentTextLight}, Dark={StaticResource AccentTextDark}}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                <Label Text="Monthly" FontSize="16" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                <Label Text="Format a monthly attendance report" FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                            </VerticalStackLayout>
                            <Button x:Name="MonthlyTemplateButton" Grid.Column="2" Text="Select"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource ActionLight}, Dark={StaticResource ActionDark}}"
                                    TextColor="{AppThemeBinding Light={StaticResource ActionTextLight}, Dark={StaticResource ActionTextDark}}"
                                    FontSize="13" FontAttributes="Bold"
                                    CornerRadius="11" Padding="13,9" VerticalOptions="Center"
                                    Clicked="OnMonthlyTemplateClicked" />
                        </Grid>
                    </Border>

                    <Border x:Name="MonthlyOptionsPanel" IsVisible="False"
                            Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" StrokeThickness="1"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                            StrokeShape="RoundRectangle 18" Padding="15">
                        <VerticalStackLayout Spacing="12">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="MONTHLY TEMPLATES" FontSize="12" FontAttributes="Bold" CharacterSpacing="1"
                                       TextColor="{AppThemeBinding Light={StaticResource SuccessLight}, Dark={StaticResource SuccessDark}}" />
                                <Label Text="Choose the layout for your monthly attendance export." FontSize="13"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                            </VerticalStackLayout>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <Border x:Name="DutyOvertimeCard"
                                        Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" StrokeThickness="1"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                                        StrokeShape="RoundRectangle 14" Padding="12">
                                    <VerticalStackLayout Spacing="8">
                                        <Label Text="Duty + OT" FontSize="15" FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                        <Label Text="Daily duty and overtime hours with monthly totals." FontSize="11"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                        <Button x:Name="MonthlyDutyButton" Text="Use this template"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource ActionLight}, Dark={StaticResource ActionDark}}"
                                                TextColor="{AppThemeBinding Light={StaticResource ActionTextLight}, Dark={StaticResource ActionTextDark}}"
                                                FontSize="12" FontAttributes="Bold" CornerRadius="10" Padding="10,8"
                                                Clicked="OnDutyOvertimeTemplateClicked" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border x:Name="InOutCard" Grid.Column="1"
                                        Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" StrokeThickness="1"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                                        StrokeShape="RoundRectangle 14" Padding="12">
                                    <VerticalStackLayout Spacing="8">
                                        <Label Text="IN / OUT" FontSize="15" FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                        <Label Text="Daily punch times with monthly attendance totals." FontSize="11"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                        <Button x:Name="MonthlyInOutButton" Text="Use this template"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource ActionLight}, Dark={StaticResource ActionDark}}"
                                                TextColor="{AppThemeBinding Light={StaticResource ActionTextLight}, Dark={StaticResource ActionTextDark}}"
                                                FontSize="12" FontAttributes="Bold" CornerRadius="10" Padding="10,8"
                                                Clicked="OnInOutTemplateClicked" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                            <Button x:Name="ManageHolidaysButton" Text="Manage holiday details"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurfaceLight}, Dark={StaticResource AccentSurfaceDark}}"
                                    TextColor="{AppThemeBinding Light={StaticResource AccentTextLight}, Dark={StaticResource AccentTextDark}}"
                                    FontSize="13" FontAttributes="Bold" CornerRadius="11" Padding="12,10"
                                    Clicked="OnManageHolidaysClicked" />
                        </VerticalStackLayout>
                    </Border>



                </VerticalStackLayout>

                <Border x:Name="UploadCard" IsVisible="False"
                        Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" StrokeThickness="1"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                        StrokeShape="RoundRectangle 20" Padding="20"
                        HorizontalOptions="Fill">
                    <Border.Shadow>
                        <Shadow Brush="Black" Opacity="0.07" Radius="14" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="14">

                        <Label x:Name="SelectedTemplateLabel" Text="" FontSize="14" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                               HorizontalTextAlignment="Center" />

                        <Button x:Name="PickFileBtn"
                                Text="Choose report file"
                                BackgroundColor="{AppThemeBinding Light={StaticResource ActionLight}, Dark={StaticResource ActionDark}}"
                                TextColor="{AppThemeBinding Light={StaticResource ActionTextLight}, Dark={StaticResource ActionTextDark}}"
                                FontSize="16" FontAttributes="Bold"
                                CornerRadius="14" HeightRequest="52"
                                Clicked="OnPickFileClicked" />

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Save as" FontSize="13" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                            <Picker x:Name="OutputFormatPicker" Title="Choose a format" SelectedIndexChanged="OnOutputFormatChanged"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                    SemanticProperties.Description="Report file format">
                                <Picker.Items>
                                    <x:String>Excel (.xlsx)</x:String>
                                    <x:String>PDF (.pdf)</x:String>
                                </Picker.Items>
                            </Picker>
                        </VerticalStackLayout>

                        <VerticalStackLayout x:Name="MonthlyPdfLayoutPanel" IsVisible="False" Spacing="4">
                            <Label Text="Monthly PDF layout" FontSize="13" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                            <Picker x:Name="MonthlyPdfLayoutPicker" Title="Choose a PDF layout"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                    SemanticProperties.Description="Monthly PDF page layout">
                                <Picker.Items>
                                    <x:String>Full month — large page (A1)</x:String>
                                    <x:String>Weekly — standard page (A4)</x:String>
                                </Picker.Items>
                            </Picker>
                            <Label Text="Full month keeps every date together. Larger employee lists continue on another page."
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                        </VerticalStackLayout>

                        <Button x:Name="ConvertBtn"
                                Text="Convert &amp; save"
                                BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurfaceLight}, Dark={StaticResource AccentSurfaceDark}}" TextColor="{AppThemeBinding Light={StaticResource AccentTextLight}, Dark={StaticResource AccentTextDark}}"
                                FontSize="16" FontAttributes="Bold"
                                CornerRadius="14" HeightRequest="52"
                                IsEnabled="False"
                                Clicked="OnConvertClicked">
                            <Button.VisualStateManager.VisualStateGroups>
                                <VisualStateGroupList>
                                    <VisualStateGroup Name="CommonStates">
                                        <VisualState Name="Normal" />
                                        <VisualState Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource DisabledSurfaceLight}, Dark={StaticResource DisabledSurfaceDark}}" />
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DisabledTextLight}, Dark={StaticResource DisabledTextDark}}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateGroupList>
                            </Button.VisualStateManager.VisualStateGroups>
                        </Button>

                        <Label x:Name="FileNameLabel" Text=""
                               FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextBodyLight}, Dark={StaticResource TextBodyDark}}"
                               HorizontalTextAlignment="Center" />

                        <Label x:Name="StatusLabel" Text=""
                               FontSize="13" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                               HorizontalTextAlignment="Center" MaxLines="4" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ContentView>

        <!-- ═══════════ results screen: saved report summary + tabs ═══════════ -->
        <Grid x:Name="ResultsSection" Grid.Row="1"
              IsVisible="False"
              RowDefinitions="Auto,Auto,Auto"
              Padding="20"
              RowSpacing="12">

            <Border Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                    StrokeThickness="1"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                    StrokeShape="RoundRectangle 18"
                    Padding="16">
                <Grid ColumnDefinitions="Auto,*,Auto"
                      RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                      ColumnSpacing="12"
                      RowSpacing="6">
                    <Border Grid.RowSpan="5"
                            WidthRequest="38" HeightRequest="38"
                            StrokeThickness="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurfaceLight}, Dark={StaticResource AccentSurfaceDark}}"
                            StrokeShape="RoundRectangle 12"
                            VerticalOptions="Start">
                        <Label Text="✓" FontSize="21" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource SuccessLight}, Dark={StaticResource SuccessDark}}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>

                    <Label Grid.Column="1" Text="Report ready" FontSize="20" FontAttributes="Bold"
                           VerticalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />

                    <Button Grid.Column="2" Grid.Row="0"
                            Text="Convert another file"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                            TextColor="{AppThemeBinding Light={StaticResource SuccessLight}, Dark={StaticResource SuccessDark}}"
                            BorderColor="{AppThemeBinding Light={StaticResource ActionLight}, Dark={StaticResource ActionDark}}"
                            BorderWidth="1" FontSize="13" FontAttributes="Bold"
                            CornerRadius="12" Padding="16,10"
                            VerticalOptions="Center" HorizontalOptions="End"
                            Clicked="OnConvertAnotherClicked" />

                    <Label x:Name="SavedLabel" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                           MaxLines="2" LineBreakMode="TailTruncation" />

                    <HorizontalStackLayout Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Spacing="10" VerticalOptions="Center">
                        <Border StrokeThickness="0"
                                BackgroundColor="{AppThemeBinding Light={StaticResource AccentSurfaceLight}, Dark={StaticResource AccentSurfaceDark}}"
                                StrokeShape="RoundRectangle 9" Padding="9,5">
                            <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                <Label x:Name="StatTotal" FontSize="14" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource AccentTextLight}, Dark={StaticResource AccentTextDark}}" />
                                <Label x:Name="StatTotalLabel" Text="rows" FontSize="11"
                                       TextColor="{AppThemeBinding Light={StaticResource AccentTextLight}, Dark={StaticResource AccentTextDark}}" />
                            </HorizontalStackLayout>
                        </Border>
                        <Label x:Name="SavedLocationLabel" FontSize="12" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource ActionLight}, Dark={StaticResource ActionDark}}"
                               TextDecorations="Underline" MaxLines="1" LineBreakMode="TailTruncation"
                               VerticalTextAlignment="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSavedLocationTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>

                    <Label x:Name="SavedPathLabel" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                           FontSize="10"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                           MaxLines="1" LineBreakMode="TailTruncation" />
                    <VerticalStackLayout Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Spacing="4">
                        <Label x:Name="ConversionNoteLabel" FontSize="11"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                               LineBreakMode="WordWrap" IsVisible="False" />
                        <Label x:Name="ConversionWarningLabel" FontSize="11"
                               TextColor="{AppThemeBinding Light=#92400E, Dark=#FCD34D}"
                               LineBreakMode="WordWrap" IsVisible="False" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- segmented tabs: Table | Dashboard + save-PDF -->
            <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                <Border Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" StrokeThickness="1" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" StrokeShape="RoundRectangle 12" Padding="4">
                    <HorizontalStackLayout Spacing="4">
                        <Button x:Name="TabTableBtn" Text="Table" CornerRadius="9" Padding="18,8"
                                FontSize="13" FontAttributes="Bold"
                                BackgroundColor="{AppThemeBinding Light={StaticResource ActionLight}, Dark={StaticResource ActionDark}}"
                                TextColor="{AppThemeBinding Light={StaticResource ActionTextLight}, Dark={StaticResource ActionTextDark}}"
                                Clicked="OnTabTableClicked" />
                        <Button x:Name="TabDashboardBtn" Text="Dashboard" CornerRadius="9" Padding="18,8"
                                FontSize="13" FontAttributes="Bold"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" TextColor="{AppThemeBinding Light={StaticResource TextBodyLight}, Dark={StaticResource TextBodyDark}}"
                                Clicked="OnTabDashboardClicked" />
                    </HorizontalStackLayout>
                </Border>
                <Button Grid.Column="2" x:Name="SavePdfBtn"
                        Text="Save dashboard as PDF"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" TextColor="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}"
                        BorderColor="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}" BorderWidth="1"
                        FontSize="13" FontAttributes="Bold"
                        CornerRadius="12" Padding="16,10"
                        HorizontalOptions="End"
                        IsVisible="False"
                        Clicked="OnSavePdfClicked" />
            </Grid>

            <!-- table tab (the converted rows, like the Excel sheet) -->
            <Border x:Name="TableCard" Grid.Row="2" Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" StrokeThickness="1" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                    StrokeShape="RoundRectangle 16" Padding="0"
                    HorizontalOptions="Fill" VerticalOptions="Fill">
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.07" Radius="14" />
                </Border.Shadow>
                <Grid>
                    <ScrollView x:Name="DailyTableScroll" Orientation="Horizontal">
                        <Grid x:Name="TableGrid" RowDefinitions="Auto,Auto" RowSpacing="0">
                            <ListView x:Name="ItemsView" Grid.Row="1" RowHeight="34"
                                      CachingStrategy="RecycleElement" SeparatorVisibility="None"
                                      BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
                        </Grid>
                    </ScrollView>
                    <Grid x:Name="MonthlyTableContainer" RowDefinitions="Auto,Auto" IsVisible="False">
                        <HorizontalStackLayout Padding="8,6" Spacing="8">
                            <Button x:Name="MonthlyAttendanceSheetBtn" Text="Attendance" CornerRadius="8" Padding="14,7"
                                    FontSize="12" FontAttributes="Bold" Clicked="OnMonthlyAttendanceSheetClicked" />
                            <Button x:Name="MonthlyHolidaySheetBtn" Text="Holiday Details" CornerRadius="8" Padding="14,7"
                                    FontSize="12" FontAttributes="Bold" Clicked="OnMonthlyHolidaySheetClicked" />
                        </HorizontalStackLayout>
                        <ScrollView x:Name="MonthlyTableScroll" Grid.Row="1" Orientation="Horizontal"
                                    HorizontalScrollBarVisibility="Always">
                            <Grid>
                                <GraphicsView x:Name="MonthlyPreviewCanvas" />
                                <Image x:Name="MonthlyTemplateLogoPreview" WidthRequest="47" HeightRequest="30"
                                       HorizontalOptions="Start" VerticalOptions="Start" Margin="1"
                                       Aspect="AspectFit" IsVisible="False" />
                            </Grid>
                        </ScrollView>
                    </Grid>
                </Grid>
            </Border>

            <!-- dashboard tab -->
            <ContentView x:Name="DashboardSection" Grid.Row="2" IsVisible="False">
                <VerticalStackLayout Spacing="12">

                    <Label x:Name="DashScope" FontSize="20" FontAttributes="Bold"
                           SemanticProperties.HeadingLevel="Level1"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                    <Label x:Name="DashSource" FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    <HorizontalStackLayout x:Name="DashPeriodControls" Spacing="8" IsVisible="False">
                        <Button x:Name="DashDailyBtn" Text="Daily" Clicked="OnDashboardDailyClicked" />
                        <Button x:Name="DashMonthlyBtn" Text="Monthly" Clicked="OnDashboardMonthlyClicked" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout x:Name="DashDateControls" Spacing="12" IsVisible="False">
                        <Label Text="Exported date" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                        <Picker x:Name="DashDatePicker" Title="Select an exported date" WidthRequest="220"
                                SelectedIndexChanged="OnDashboardDateChanged"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                    </HorizontalStackLayout>
                    <Label Text="Punch evidence only. No punches does not establish absence or leave. Average hours uses complete pairs."
                           FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />

                    <Grid x:Name="DashKpis" RowSpacing="12" ColumnSpacing="12" SizeChanged="OnDashboardKpiSizeChanged" />
                    <VerticalStackLayout x:Name="DashVisuals" Spacing="16" />

                    <Border x:Name="DashCoverageCard" Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" StrokeThickness="1" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                            StrokeShape="RoundRectangle 16" Padding="14">
                        <Border.Shadow><Shadow Brush="Black" Opacity="0.07" Radius="14" /></Border.Shadow>
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Punch coverage by exported date" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                            <HorizontalStackLayout Spacing="12">
                                <HorizontalStackLayout Spacing="4">
                                    <BoxView Color="{AppThemeBinding Light={StaticResource SuccessLight}, Dark={StaticResource SuccessDark}}" WidthRequest="12" HeightRequest="12" VerticalOptions="Center" />
                                    <Label Text="complete pairs" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="4">
                                    <BoxView Color="#94A3B8" WidthRequest="12" HeightRequest="12" VerticalOptions="Center" />
                                    <Label Text="no punches" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="4">
                                    <BoxView Color="{AppThemeBinding Light={StaticResource WarningLight}, Dark={StaticResource WarningDark}}" WidthRequest="12" HeightRequest="12" VerticalOptions="Center" />
                                    <Label Text="incomplete pairs" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </HorizontalStackLayout>
                            <ScrollView Orientation="Horizontal" HeightRequest="150">
                                <Grid x:Name="DashChartGrid" ColumnSpacing="2" VerticalOptions="End" />
                            </ScrollView>
                        </VerticalStackLayout>
                    </Border>

                    <Border Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" StrokeThickness="1" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                            StrokeShape="RoundRectangle 16" Padding="10">
                        <Border.Shadow><Shadow Brush="Black" Opacity="0.07" Radius="14" /></Border.Shadow>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Employee summary" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" Padding="6,0" />
                            <ScrollView Orientation="Horizontal">
                                <StackLayout x:Name="DashEmployeeTable" Spacing="0" />
                            </ScrollView>
                        </VerticalStackLayout>
                    </Border>

                    <Label x:Name="DashStatus" Text="" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                </VerticalStackLayout>
            </ContentView>
        </Grid>

            </Grid>
        </ScrollView>

        <!-- Dedicated editing workspace: use the window width instead of the setup-card width. -->
        <Grid x:Name="HolidaySection" IsVisible="False"
              Margin="24,28,24,24" RowDefinitions="Auto,Auto,*" RowSpacing="24">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Holiday details" FontSize="28" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                    <Label Text="Manage holiday dates, names, and categories. Use Edit to update a holiday."
                           FontSize="14" LineBreakMode="WordWrap"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                </VerticalStackLayout>
                <Button x:Name="HolidayBackButton" Grid.Column="1" Text="Back" FontSize="14" FontAttributes="Bold"
                        Padding="20,12" CornerRadius="10" VerticalOptions="Start"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                        TextColor="{AppThemeBinding Light={StaticResource TextBodyLight}, Dark={StaticResource TextBodyDark}}"
                        Clicked="OnHolidayManagerBackClicked" />
            </Grid>
            <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="20">
                <Button x:Name="AddHolidayButton" Text="+ Add holiday" HorizontalOptions="Start"
                        BackgroundColor="{AppThemeBinding Light={StaticResource ActionLight}, Dark={StaticResource ActionDark}}"
                        TextColor="{AppThemeBinding Light={StaticResource ActionTextLight}, Dark={StaticResource ActionTextDark}}"
                        FontSize="14" FontAttributes="Bold" CornerRadius="10" Padding="24,12"
                        Clicked="OnAddHolidayClicked" />
                <ActivityIndicator x:Name="HolidayBusyIndicator" Grid.Column="1" IsVisible="False" IsRunning="False"
                                   Color="{AppThemeBinding Light={StaticResource SuccessLight}, Dark={StaticResource SuccessDark}}" />
                <Label x:Name="HolidaySaveStatus" Grid.Column="2" Text="" FontSize="13"
                       VerticalTextAlignment="Center" LineBreakMode="WordWrap"
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
            </Grid>
            <Border x:Name="HolidayManagerCard" Grid.Row="2" IsVisible="False"
                    Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                    StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="20"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                <ScrollView x:Name="HolidayTableScroll" Orientation="Horizontal"
                            HorizontalScrollBarVisibility="Default" VerticalScrollBarVisibility="Default"
                            SizeChanged="OnHolidayTableSizeChanged">
                    <Grid x:Name="HolidayTableLayout" MinimumWidthRequest="1040" RowDefinitions="Auto,*" RowSpacing="12">
                        <!-- Header and virtualized rows use the same column layout resource. -->
                        <Grid x:Name="HolidayTableHeader" ColumnDefinitions="{local:HolidayTableColumns}"
                              ColumnSpacing="20" Padding="0,0,0,12" MinimumHeightRequest="40">
                            <Label Text="Date" Margin="12,0" FontSize="13" FontAttributes="Bold" VerticalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                            <Label Grid.Column="1" Text="Holiday name" Margin="12,0" FontSize="13" FontAttributes="Bold" VerticalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                            <Label Grid.Column="2" Text="Category" Margin="12,0" FontSize="13" FontAttributes="Bold" VerticalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                            <Label Grid.Column="3" Text="Actions" FontSize="13" FontAttributes="Bold" VerticalTextAlignment="Center" HorizontalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                        </Grid>
                        <CollectionView x:Name="HolidayList" Grid.Row="1" SelectionMode="None"
                                        ItemSizingStrategy="MeasureAllItems" VerticalScrollBarVisibility="Default">
                            <CollectionView.EmptyView>
                                <Label Text="No holidays yet. Use Add holiday to create one." Margin="12,24" FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="core:HolidayEntry">
                                    <Grid ColumnDefinitions="{local:HolidayTableColumns}" ColumnSpacing="20"
                                          MinimumHeightRequest="76" Padding="0,12">
                                        <Label Margin="12,0" Text="{Binding Date, StringFormat='{0:dd/MM/yyyy}'}" FontSize="14" VerticalTextAlignment="Center"
                                               TextColor="{AppThemeBinding Light={StaticResource TextBodyLight}, Dark={StaticResource TextBodyDark}}" />
                                        <Label Grid.Column="1" Margin="12,0" Text="{Binding Name}" FontSize="14" VerticalTextAlignment="Center" LineBreakMode="WordWrap"
                                               TextColor="{AppThemeBinding Light={StaticResource TextBodyLight}, Dark={StaticResource TextBodyDark}}" />
                                        <Label Grid.Column="2" Margin="12,0" Text="{Binding Category}" FontSize="14" VerticalTextAlignment="Center" LineBreakMode="WordWrap"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                        <Grid Grid.Column="3" ColumnDefinitions="*,*" ColumnSpacing="8" VerticalOptions="Center">
                                            <Button Text="Edit" FontSize="13" Padding="12,10" CornerRadius="8"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource SurfaceAltDark}}"
                                                    TextColor="{AppThemeBinding Light={StaticResource TextBodyLight}, Dark={StaticResource TextBodyDark}}"
                                                    SemanticProperties.Description="{Binding Name, StringFormat='Edit {0}'}"
                                                    Clicked="OnEditHolidayClicked" />
                                            <Button Grid.Column="1" Text="Delete" FontSize="13" Padding="12,10" CornerRadius="8" BackgroundColor="Transparent"
                                                    TextColor="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}"
                                                    SemanticProperties.Description="{Binding Name, StringFormat='Delete {0}'}"
                                                    Clicked="OnDeleteHolidayClicked" />
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>
                </ScrollView>
            </Border>
        </Grid>


        <ActivityIndicator x:Name="Spinner"
                           IsRunning="False" IsVisible="False"
                           Color="{AppThemeBinding Light={StaticResource ActionLight}, Dark={StaticResource ActionDark}}"
                           VerticalOptions="Center" HorizontalOptions="Center" />
        <local:HolidayEditorDialog x:Name="HolidayDialog" IsVisible="False" ZIndex="10" />
    </Grid>

</ContentPage>
