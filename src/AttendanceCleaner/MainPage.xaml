<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:core="clr-namespace:AttendanceCleaner.Core"
             x:Class="AttendanceCleaner.MainPage"
             Title="Attendance Cleaner">

    <Grid RowDefinitions="Auto,*">

        <!-- convert section -->
        <VerticalStackLayout
            x:Name="ConvertSection"
            VerticalOptions="Center"
            Padding="40"
            Spacing="20">

            <Label
                Text="Attendance Cleaner"
                FontSize="28"
                FontAttributes="Bold"
                HorizontalTextAlignment="Center" />

            <Label
                Text="Choose the report downloaded from the attendance software. The clean Excel is saved next to it."
                FontSize="15"
                TextColor="Gray"
                HorizontalTextAlignment="Center" />

            <Button
                x:Name="PickFileBtn"
                Text="Choose Excel file"
                Clicked="OnPickFileClicked"
                HorizontalOptions="Fill" />

            <Button
                x:Name="ConvertBtn"
                Text="Convert &amp; save"
                IsEnabled="False"
                Clicked="OnConvertClicked"
                HorizontalOptions="Fill" />

            <Label
                x:Name="FileNameLabel"
                Text=""
                FontSize="13"
                HorizontalTextAlignment="Center" />

            <Label
                x:Name="StatusLabel"
                Text=""
                FontSize="13"
                HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <!-- results section: the converted rows, shown like the Excel sheet -->
        <Grid
            x:Name="ResultsSection"
            Grid.Row="1"
            IsVisible="False"
            RowDefinitions="Auto,Auto,Auto,*"
            Padding="16"
            RowSpacing="4">

            <Label x:Name="SummaryLabel" FontAttributes="Bold" FontSize="16" />

            <Label x:Name="SavedLabel" Grid.Row="1" FontSize="12" TextColor="#6B7280" />

            <Button
                Grid.Row="2"
                Text="Convert another file"
                FontSize="12"
                Padding="14,6"
                HorizontalOptions="Start"
                Clicked="OnConvertAnotherClicked" />

            <ScrollView Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                <Grid RowDefinitions="Auto,Auto" WidthRequest="745" RowSpacing="0">

                    <Grid ColumnDefinitions="45,55,170,55,90,45,65,65,70,85" BackgroundColor="#F3F4F6">
                        <Label Text="Sl.No" FontAttributes="Bold" FontSize="12" Padding="4,8" HorizontalTextAlignment="Center" />
                        <Label Grid.Column="1" Text="ID No" FontAttributes="Bold" FontSize="12" Padding="4,8" HorizontalTextAlignment="Center" />
                        <Label Grid.Column="2" Text="Name" FontAttributes="Bold" FontSize="12" Padding="8,8" />
                        <Label Grid.Column="3" Text="Genter" FontAttributes="Bold" FontSize="12" Padding="4,8" HorizontalTextAlignment="Center" />
                        <Label Grid.Column="4" Text="Date" FontAttributes="Bold" FontSize="12" Padding="4,8" HorizontalTextAlignment="Center" />
                        <Label Grid.Column="5" Text="Day" FontAttributes="Bold" FontSize="12" Padding="4,8" HorizontalTextAlignment="Center" />
                        <Label Grid.Column="6" Text="In punch" FontAttributes="Bold" FontSize="12" Padding="4,8" HorizontalTextAlignment="Center" />
                        <Label Grid.Column="7" Text="Out punch" FontAttributes="Bold" FontSize="12" Padding="4,8" HorizontalTextAlignment="Center" />
                        <Label Grid.Column="8" Text="Total hours" FontAttributes="Bold" FontSize="12" Padding="4,8" HorizontalTextAlignment="Center" />
                        <Label Grid.Column="9" Text="Remarks" FontAttributes="Bold" FontSize="12" Padding="4,8" />
                    </Grid>

                    <ScrollView Grid.Row="1">
                        <StackLayout BindableLayout.ItemsSource="{Binding Rows}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="core:TemplateRow">
                                    <Grid RowDefinitions="Auto,1" ColumnDefinitions="45,55,170,55,90,45,65,65,70,85" BackgroundColor="White">
                                        <Label Text="{Binding SlNo}" FontSize="12" Padding="4,7" HorizontalTextAlignment="Center" />
                                        <Label Grid.Column="1" Text="{Binding IdNo}" FontSize="12" Padding="4,7" HorizontalTextAlignment="Center" />
                                        <Label Grid.Column="2" Text="{Binding Name}" FontSize="12" Padding="8,7" LineBreakMode="TailTruncation" />
                                        <Label Grid.Column="3" Text="{Binding Gender}" FontSize="12" Padding="4,7" HorizontalTextAlignment="Center" />
                                        <Label Grid.Column="4" Text="{Binding DateText}" FontSize="12" Padding="4,7" HorizontalTextAlignment="Center" />
                                        <Label Grid.Column="5" Text="{Binding Day}" FontSize="12" Padding="4,7" HorizontalTextAlignment="Center" />
                                        <Label Grid.Column="6" Text="{Binding InPunch}" FontSize="12" Padding="4,7" HorizontalTextAlignment="Center" />
                                        <Label Grid.Column="7" Text="{Binding OutPunch}" FontSize="12" Padding="4,7" HorizontalTextAlignment="Center" />
                                        <Label Grid.Column="8" Text="{Binding TotalHours}" FontSize="12" Padding="4,7" HorizontalTextAlignment="Center" />
                                        <Label Grid.Column="9" Text="{Binding Remark}" FontSize="12" Padding="4,7" />
                                        <BoxView Grid.Row="1" Grid.ColumnSpan="10" HeightRequest="1" Color="#E5E7EB" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </StackLayout>
                    </ScrollView>
                </Grid>
            </ScrollView>
        </Grid>

        <ActivityIndicator
            x:Name="Spinner"
            IsRunning="False"
            IsVisible="False"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            Grid.RowSpan="2" />
    </Grid>

</ContentPage>
