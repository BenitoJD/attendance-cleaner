<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AttendanceCleaner.MainPage"
             Title="Attendance Cleaner">

    <Grid>
        <VerticalStackLayout
            VerticalOptions="Center"
            Padding="40"
            Spacing="20">

            <Label
                Text="Attendance Cleaner"
                FontSize="28"
                FontAttributes="Bold"
                HorizontalTextAlignment="Center" />

            <Label
                Text="Choose the report downloaded from the attendance software. The clean Excel is saved next to it."
                FontSize="15"
                TextColor="Gray"
                HorizontalTextAlignment="Center" />

            <Button
                x:Name="PickFileBtn"
                Text="Choose Excel file"
                Clicked="OnPickFileClicked"
                HorizontalOptions="Fill" />

            <Button
                x:Name="ConvertBtn"
                Text="Convert &amp; save"
                IsEnabled="False"
                Clicked="OnConvertClicked"
                HorizontalOptions="Fill" />

            <Label
                x:Name="FileNameLabel"
                Text=""
                FontSize="13"
                HorizontalTextAlignment="Center" />

            <Label
                x:Name="StatusLabel"
                Text=""
                FontSize="13"
                HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <ActivityIndicator
            x:Name="Spinner"
            IsRunning="False"
            IsVisible="False"
            VerticalOptions="Center"
            HorizontalOptions="Center" />
    </Grid>

</ContentPage>
